{
  "name": "@pink-paprikaa-web/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test *.test.mjs rules/*.test.mjs ../scripts/*.test.mjs"
  },
  "exports": {
    "./base": "./base.js",
    "./react": "./react.js",
    "./next": "./next.js",
    "./atomic-layering": "./atomic-layering.js",
    "./import-sort": "./import-sort.js"
  },
  "nx": {
    "tags": [
      "type:tool",
      "scope:shared"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "{workspaceRoot}/tools/scripts/**/*"
        ]
      }
    }
  }
}
