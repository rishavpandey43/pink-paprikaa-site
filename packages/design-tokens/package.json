{
  "name": "@pink-paprikaa-web/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "style-dictionary build --config sd.config.mjs"
  },
  "exports": {
    "./theme.css": "./dist/theme.css",
    "./surfaces.css": "./dist/surfaces.css",
    "./tokens.json": "./dist/tokens.json",
    "./contrast": {
      "types": "./src/contrast.ts",
      "import": "./src/contrast.ts",
      "default": "./src/contrast.ts"
    },
    "./catalogue": {
      "types": "./src/catalogue.ts",
      "import": "./src/catalogue.ts",
      "default": "./src/catalogue.ts"
    },
    "./contrast-pairs.json": "./contrast-pairs.json"
  },
  "nx": {
    "tags": [
      "type:tokens",
      "scope:shared"
    ],
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/tokens/**/*",
          "{projectRoot}/sd.config.mjs"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
