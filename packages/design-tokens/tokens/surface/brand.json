{
  "surface-brand": {
    "color": {
      "$type": "color",
      "text": {
        "heading": { "$value": "{color.ink.000}" },
        "body": { "$value": "{color.ink.000}" },
        "muted": { "$value": "{color.white-alpha.92}" },
        "subtle": { "$value": "{color.white-alpha.85}" },
        "brand": { "$value": "{color.ink.000}" },
        "link": { "$value": "{color.ink.000}" },
        "link-hover": { "$value": "{color.ink.000}" }
      },
      "link": {
        "underline": { "$value": "{color.white-alpha.40}" },
        "quiet": { "$value": "{color.white-alpha.85}" }
      },
      "border": {
        "subtle": { "$value": "{color.white-alpha.22}" },
        "default": { "$value": "{color.white-alpha.42}" },
        "strong": { "$value": "{color.ink.000}" }
      },
      "surface": { "card": { "$value": "{color.white-alpha.10}" } },
      "focus": { "$value": "{color.ink.000}" },
      "button": {
        "primary": {
          "bg": { "$value": "{color.ink.000}" },
          "bg-hover": { "$value": "{color.pink.50}" },
          "bg-active": { "$value": "{color.ink.100}" },
          "fg": { "$value": "{color.pink.600}" }
        },
        "secondary": {
          "bg": { "$value": "transparent" },
          "border": { "$value": "{color.white-alpha.70}" }
        },
        "hover-tint": { "$value": "{color.white-alpha.16}" }
      },
      "icon-button": { "ghost": { "fg": { "$value": "{color.ink.000}" } } },
      "tag": {
        "selected": { "$value": "{color.ink.900}" },
        "selected-hover": { "$value": "{color.ink.800}" }
      },
      "divider": { "mark": { "$value": "{color.ink.000}" } },
      "badge": {
        "brand": {
          "bg": { "$value": "{color.ink.000}" },
          "fg": { "$value": "{color.pink.600}" }
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "focus-ring": { "$value": "{shadow.focus-ring-inverse}" },
      "button-primary": { "$value": "{shadow.2}" }
    }
  }
}
