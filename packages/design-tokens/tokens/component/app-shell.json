    "app-shell-sm-w": {
      "$value": "360px",
      "$description": "AppShell size=\"phone-sm\": the system's 360px floor.",
      "$extensions": { "pink-paprikaa": { "utility": ["w"] } }
    },
    "app-shell-sm-h": {
      "$value": "780px",
      "$description": "AppShell size=\"phone-sm\" height.",
      "$extensions": { "pink-paprikaa": { "utility": ["h"] } }
    },
    "app-shell-status-x": { "$value": "22px", "$description": "Status bar side inset." },
    "app-shell-home": {
      "$value": "22px",
      "$description": "Home-indicator strip height.",
      "$extensions": { "pink-paprikaa": { "utility": ["h"] } }
