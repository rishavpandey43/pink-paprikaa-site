      "brand-soft": { "$value": "{color.pink.200}" }
    },
    "brand": {
      "hover": { "$value": "{color.pink.600}" },
      "active": { "$value": "{color.pink.700}" }
    },
    "status": {
      "success": { "$value": "{color.mint}" },
      "success-soft": { "$value": "{color.mint-soft}" },
      "warning": { "$value": "{color.turmeric}" },
