      "warning": { "$value": "{color.turmeric-strong}" },
      "danger": { "$value": "{color.danger}" },
      "info": { "$value": "{color.kesar-strong}" }
    },
    "border": {
      "subtle": { "$value": "{color.ink.200}" },
