      "info-soft": { "$value": "{color.kesar-soft}" }
    },
    "heat": {
      "1": { "$value": "{color.mint}" },
      "2": { "$value": "{color.turmeric}" },
      "3": { "$value": "{color.tandoor}" },
      "4": { "$value": "{color.pink.600}" }
    },
    "focus": {
      "$value": "{color.pink.500}",
      "$description": "Focus outline colour; white on dark surfaces."
