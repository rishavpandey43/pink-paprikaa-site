{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    // Base's `module`/`moduleResolution: nodenext` resolves each file's
    // CJS-vs-ESM-ness from the nearest `package.json` "type" field, which
    // this project (like `apps/web`, `packages/ui`) doesn't set — under
    // `verbatimModuleSyntax` that makes plain `.ts` spec files fail to
    // typecheck their own `import` statements (TS1295). Playwright's own
    // config loader is bundler-based regardless, so match the same
    // esnext/bundler override the other generated projects already use.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "playwright.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs"
  ]
}
