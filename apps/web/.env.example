# Copy to `.env` for local work. `.env` and `.env.local` are gitignored.
#
# Nothing here is a secret. Every variable in this file is `NEXT_PUBLIC_`, which
# means Next INLINES it into the client bundle at build time — it is readable by
# anyone who views source. Never put a token, key or password in this file or in
# any `NEXT_PUBLIC_` variable. (Meta's Conversions API access token, if that is
# ever adopted, is server-side only and must never appear here.)

# Meta Pixel / dataset id — "Pink Paprikaa Website".
# Unset or non-numeric = pixel disabled, nothing loads, no requests are made.
# Because this is inlined at build time, changing it requires a rebuild and
# redeploy, not a Netlify environment change.
NEXT_PUBLIC_META_PIXEL_ID=1339451664838482

# NOT set here, and not `NEXT_PUBLIC_`: Netlify injects `CONTEXT` at build time
# as `production` | `deploy-preview` | `branch-deploy`. It gates the
# server-rendered `<noscript>` fallback so deploy previews — which inherit these
# same variables — do not ship a live tracking pixel. Leave it unset locally.
