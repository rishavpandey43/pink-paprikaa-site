{
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm add *)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm nx *)",
      "Bash(pnpm why *)",
      "Bash(pnpm list*)",
      "Bash(pnpm outdated*)",
      "Bash(npx nx *)",
      "Bash(nx *)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(npm view *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git stash*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git rebase*)",
      "Bash(pnpm publish*)",
      "Bash(netlify deploy*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git filter-branch*)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "www.google-analytics.com",
        "registry.npmjs.org",
        "nodejs.org",
        "github.com",
        "objects.githubusercontent.com"
      ]
    }
  }
}
